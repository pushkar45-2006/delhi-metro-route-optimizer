# Copy this file to a new file named ".env" in the project root,
# then fill in real values there. Never commit the real ".env" file.

PORT=5000

# Local MongoDB (see README for setup instructions):
MONGODB_URI=mongodb://localhost:27017/delhi_metro

# If you use MongoDB Atlas instead, replace the line above with
# something like (do NOT commit your real password anywhere):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/delhi_metro